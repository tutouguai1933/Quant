{
  "bot_name": "quant-futures-live",
  "dry_run": false,
  "dry_run_wallet": 1000,
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 9,
  "tradable_balance_ratio": 0.95,
  "timeframe": "1h",
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.futures.sqlite",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "enable_ws": false,
    "ccxt_config": {
      "enableRateLimit": true,
      "proxies": {
        "http": "http://127.0.0.1:7890",
        "https": "http://127.0.0.1:7890"
      },
      "aiohttp_proxy": "http://127.0.0.1:7890"
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 200,
      "proxies": {
        "http": "http://127.0.0.1:7890",
        "https": "http://127.0.0.1:7890"
      },
      "aiohttp_proxy": "http://127.0.0.1:7890"
    },
    "pair_whitelist": [
      "ETH/USDT:USDT",
      "BTC/USDT:USDT",
      "XRP/USDT:USDT",
      "DOGE/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 9014,
    "username": "Freqtrader",
    "password": "jianyu0.0.",
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  },
  "initial_state": "running",
  "force_entry_enable": true,
  "internals": {
    "process_throttle_secs": 5
  }
